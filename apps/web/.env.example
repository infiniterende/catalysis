# Copy this file to .env.local and fill in the values. Never commit .env.local.

# --- Database ---------------------------------------------------------------
# Cloud SQL (Postgres). Locally, run the Cloud SQL Auth Proxy (see DEVELOPMENT.md) and point at it:
# DATABASE_URL=postgresql://catalysis:<password>@127.0.0.1:5434/catalysis
# On Cloud Run it comes from Secret Manager (catalysis-database-url) and uses the /cloudsql socket.

# --- Lumen (AI assistant) -------------------------------------------------
# Gemini on Vertex AI. There is no key: the server signs in as itself (Cloud Run's
# service account, or your `gcloud auth application-default login` on this machine).
# Without a project, Lumen answers from a few scripted demo replies.
GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=global
# LUMEN_GEMINI_MODEL=gemini-3.8-flash

# Optional: Claude instead of Gemini.
# ANTHROPIC_API_KEY=
# LUMEN_PROVIDER=anthropic
# LUMEN_MODEL=claude-opus-5

# --- Landing page ---------------------------------------------------------
# Optional. Shows the "Download for iOS" button when set.
# NEXT_PUBLIC_IOS_APP_URL=

# Optional: the model that screens TikTok captions before a video can appear in Reels.
# SCREENING_GEMINI_MODEL=gemini-3.5-flash-lite
# SCREENING_MODEL=claude-opus-5   # when LUMEN_PROVIDER=anthropic

# Optional: what a visitor trying the demo account may have of Lumen.
# DEMO_LUMEN_TOKENS=100        # most tokens per answer
# DEMO_LUMEN_QUESTIONS=5       # answers per visitor per day (0 turns Lumen off in the demo)
# DEMO_LUMEN_DAILY_TOTAL=300   # answers for all visitors together per day

# Optional: set to "off" to stop fetching the Liturgy of the Hours from iBreviary.
# The Hours page then shows a link to iBreviary instead.
# HOURS_SOURCE=off
