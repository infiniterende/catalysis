# Copy this file to .env.local and fill in the values. Never commit .env.local.

# --- Lumen (AI assistant) -------------------------------------------------
# Server-side only; these keys are never sent to the browser.
# Set ONE of the two keys. With neither, Lumen answers from a few scripted demo replies.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional. Which provider to use when both keys are set: "openai" or "anthropic".
# LUMEN_PROVIDER=openai
# Optional model overrides.
# LUMEN_OPENAI_MODEL=gpt-5.5
# LUMEN_MODEL=claude-opus-5

# --- Landing page ---------------------------------------------------------
# Optional. Shows the "Download for iOS" button when set.
# NEXT_PUBLIC_IOS_APP_URL=

# Optional: the model that screens TikTok captions before a video can appear in Reels.
# Defaults to Lumen's model.
# SCREENING_MODEL=
# SCREENING_OPENAI_MODEL=

# Optional: what a visitor trying the demo account may have of Lumen.
# DEMO_LUMEN_TOKENS=100        # most tokens per answer
# DEMO_LUMEN_QUESTIONS=5       # answers per visitor per day (0 turns Lumen off in the demo)
# DEMO_LUMEN_DAILY_TOTAL=300   # answers for all visitors together per day
